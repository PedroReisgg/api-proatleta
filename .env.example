# Copie para .env e ajuste. Nenhuma destas variaveis e obrigatoria para
# subir a API, mas DATABASE_URL e ADMIN_TOKEN sao essenciais em producao.

# ---------------------------------------------------------------- servidor
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------ armazenamento
# Com DATABASE_URL a API usa PostgreSQL. Sem ela, grava em arquivo JSON, o que
# serve para rodar local mas NAO para producao no Render (disco efemero).
# No Render, crie um PostgreSQL e cole aqui a "Internal Database URL".
DATABASE_URL=
ARQUIVO_DADOS=data/peneiras.json

# ----------------------------------------------------------- coleta automatica
COLETA_ATIVADA=true
# Coleta incremental (fontes de prioridade 1 e 2), de 3 em 3 horas.
COLETA_CRON=15 */3 * * *
# Coleta profunda (todas as fontes), uma vez por dia as 5h30.
COLETA_PROFUNDA_CRON=30 5 * * *
FUSO_CRON=America/Sao_Paulo
# Dispara uma coleta logo depois de o servidor subir.
COLETAR_NO_BOOT=true
ATRASO_BOOT_MS=15000

PRIORIDADE_INCREMENTAL=2
PRIORIDADE_PROFUNDA=4
JANELA_INCREMENTAL_DIAS=21
JANELA_PROFUNDA_DIAS=120
CONCORRENCIA_FONTES=4
TEMPO_MAX_COLETA_MS=600000

# Apaga peneiras encerradas com mais de N dias. 0 desliga a limpeza.
DIAS_RETENCAO=365

# ------------------------------------------------------------------ rede
HTTP_TIMEOUT_MS=20000
HTTP_RETRIES=3
HTTP_CONCURRENCY=8
HTTP_CONCURRENCY_HOST=2

# -------------------------------------------------------------------- api
CACHE_TTL_SEGUNDOS=120
LIMITE_PADRAO=50
# Lista separada por virgula. Vazio libera qualquer origem.
CORS_ORIGENS=
# Descarta itens com confianca abaixo deste valor (0 a 100).
CONFIANCA_MINIMA=0

# Obrigatorio para usar POST /admin/coleta. Sem ele as rotas /admin ficam off.
# Gere um valor longo e aleatorio.
ADMIN_TOKEN=
